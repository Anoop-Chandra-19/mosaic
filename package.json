{
  "name": "mosaic",
  "productName": "Mosaic",
  "description": "Local-first resume builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:reset": "rm -rf .dev-data",
    "db:freeze": "bun scripts/freeze-migrations.ts",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun run build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && xvfb-run -a -s \"-screen 0 1920x1080x24\" playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.0.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@react-pdf/renderer": "^4.4.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "immer": "^11.1.4",
    "lint-staged": "^16.3.1",
    "lucide-react": "^0.575.0",
    "prettier": "^3.8.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "zustand": "^5.0.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
