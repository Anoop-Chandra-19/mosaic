{
  "name": "mosaic",
  "productName": "Mosaic",
  "description": "Local-first resume builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:reset": "node scripts/reset-dev-data.ts",
    "db:freeze": "node scripts/freeze-migrations.ts",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "package": "tsc -b && electron-vite build --mode release && electron-builder",
    "lint": "eslint .",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "graph": "node scripts/graphify.ts",
    "graph:build": "node scripts/graphify.ts extract . --code-only",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "check:typing": "electron-vite build && node scripts/run-under-load.ts scripts/typing-check/playwright.config.ts",
    "check:speed": "electron-vite build && node scripts/run-under-load.ts scripts/speed-check/playwright.config.ts",
    "check:memory": "electron-vite build && playwright test -c scripts/memory-check/playwright.config.ts",
    "check:transcript": "electron-vite build && node scripts/run-under-load.ts scripts/transcript-check/playwright.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.29.1",
    "@napi-rs/keyring": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "openai": "7.32.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@react-pdf/renderer": "^4.4.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "dependency-cruiser": "^18.7.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "immer": "^11.1.4",
    "lint-staged": "^16.3.1",
    "lucide-react": "^0.575.0",
    "oxfmt": "0.72.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "react-remove-scroll": "^2.7.2",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "oxfmt --write"
    ],
    "*.{json,css,md}": [
      "oxfmt --write"
    ]
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
